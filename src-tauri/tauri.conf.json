{
  "$schema": "https://docs.tauri.app/schema/tauri-v2_0.json",
  "productName": "Atlas Launcher",
  "version": "1.0.0",
  "identifier": "com.atlaslauncher.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Atlas Launcher",
        "width": 1280,
        "height": 760,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "maximized": false,
        "decorations": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "copyright": "Copyright © 2026 Atlas Launcher",
    "category": "Entertainment",
    "shortDescription": "Universal Game Library Consolidator",
    "longDescription": "Atlas Launcher - Organiza y sostiene toda tu biblioteca de videojuegos."
  }
}
